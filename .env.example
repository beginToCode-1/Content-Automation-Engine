GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
YOUTUBE_API_KEY=
UPLOAD_PRIVACY_STATUS=private
WORK_DIR=work
LOG_LEVEL=INFO

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_MAX_WORKERS=2
# Postgres connection string (Supabase or any Postgres host). Use the
# **Session pooler** connection string, not Transaction pooler - this app
# holds its own persistent connection pool rather than opening brief
# per-request connections, and Transaction-mode pooling disables prepared
# statements, which psycopg3 enables by default after repeated queries.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SCHEDULER_POLL_INTERVAL_S=30
# Transient upload failures (network blips, timeouts, 5xx/429) are retried with
# exponential backoff (UPLOAD_RETRY_BACKOFF_BASE_S * 2^attempt) before the run
# is marked failed. Non-transient failures (bad credentials, rejected content)
# are never retried.
UPLOAD_MAX_RETRIES=3
UPLOAD_RETRY_BACKOFF_BASE_S=2
# Signs login sessions (JWTs). Generate your own - never reuse this example -
# with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Encrypts stored per-user OAuth tokens (connected YouTube accounts) at rest.
# Generate your own with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Per-user "Connect YouTube" flow (web application OAuth client - NOT the
# Desktop client used by the CLI's client_secret.json). Create one at
# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Application type "Web application",
# with an Authorized redirect URI matching GOOGLE_OAUTH_REDIRECT_URI below.
# Leave all three blank to disable the connect flow (nothing else breaks).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/youtube/callback
# The deployed frontend's origin - where the browser is sent back to after a
# connect attempt finishes.
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated list of frontend origins allowed to call this API (e.g. your
# Vercel deployment URL). Leave blank for local dev (same-origin Jinja pages).
CORS_ALLOW_ORIGINS=

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v21.0
# Leave blank to use the automatic ngrok tunnel below (if NGROK_AUTHTOKEN is
# set); set explicitly to a fixed public host (e.g. in production) instead.
INSTAGRAM_PUBLIC_VIDEO_BASE_URL=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional. If set (and this isn't a deployed/PORT-injected environment), the
# dashboard automatically starts an ngrok tunnel to itself on boot - used by
# Instagram uploads (as a fallback for INSTAGRAM_PUBLIC_VIDEO_BASE_URL) and by
# `python run.py --tiktok-auth <redirect_uri>`. Get a free token at
# https://dashboard.ngrok.com/get-started/your-authtoken. Leave blank to keep
# running `ngrok` yourself.
NGROK_AUTHTOKEN=

BATCH_DEFAULT_STAGGER_MINUTES=180
BATCH_MAX_VIDEOS=5
BATCH_MAX_CLIPS_PER_VIDEO=5

# Notifications fire on every completed upload (any platform, any trigger source)
# once enabled. Off by default so behavior doesn't change until you opt in.
NOTIFICATIONS_ENABLED=false
NOTIFY_DESKTOP_ENABLED=true
NOTIFY_EMAIL_ENABLED=true
NOTIFY_EMAIL_TO=
# Gmail rejects plain-password SMTP auth - create an App Password at
# Google Account -> Security -> 2-Step Verification -> App Passwords, and use
# that here instead of your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
